    "allow": [
      "Bash(git *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh label list*)",
      "Bash(go mod download)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(gofmt -l *)",
      "Bash(gofmt -w *)",
      "Bash(go generate *)",
      "Bash(go tool goose -dir db/migrations -s create *)",
      "Bash(bash scripts/check-links.sh)",
      "PowerShell(git *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh label list*)",
      "PowerShell(go mod download)",
      "PowerShell(go build *)",
      "PowerShell(go vet *)",
      "PowerShell(go test *)",
      "PowerShell(gofmt -l *)",
      "PowerShell(gofmt -w *)",
      "PowerShell(go generate *)",
      "PowerShell(go tool goose -dir db/migrations -s create *)",
