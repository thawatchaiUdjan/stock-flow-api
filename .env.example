# Copy to .env and fill in. Never commit .env.
# In production, Vercel's Supabase integration injects the POSTGRES_* and SUPABASE_* variables into the api project.
# The stack ticket's scaffold owns these names: keep this file in step with what the code reads.

# Port the HTTP server listens on. Vercel sets PORT itself.
PORT=8080

# App connection: Supabase transaction pooler (port 6543), injected by Vercel as POSTGRES_URL.
# Transaction mode does not support prepared statements: pgx runs in simple-protocol mode.
# Confirm the port on the first deploy: the integration's docs don't state which pooler this is.
POSTGRES_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres

# Migrations (goose): Supabase session pooler (port 5432, IPv4). Set by hand here and as a GitHub Actions secret;
# not from Vercel. GitHub-hosted runners have no IPv6, so the direct connection can't be used.
# Supabase dashboard > Connect > Session pooler.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Supabase project URL and secret key, used to issue signed upload URLs for product images.
# Server-side only: never expose it to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<secret-key>

# Public-read Storage bucket that holds product images.
SUPABASE_STORAGE_BUCKET=product-images
