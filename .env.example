# Copy to .env and fill in. Never commit .env.
# In production these are set as environment variables on Render, not from a file.
# The stack ticket's scaffold owns these names: keep this file in step with what the code reads.

# Port the HTTP server listens on. Render sets PORT itself.
PORT=8080

# Supabase Postgres through the session pooler (port 5432, IPv4).
# Supabase dashboard > Connect > Session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Supabase project URL and secret key, used to issue signed upload URLs for product images.
# Supabase dashboard > Project Settings > API Keys. Server-side only: never expose it to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<secret-key>

# Public-read Storage bucket that holds product images.
SUPABASE_STORAGE_BUCKET=product-images
