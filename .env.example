# Copy to .env and fill in. Never commit .env. `go run ./cmd/api` loads it; variables
# already set in the environment win.
# In production, Vercel's Supabase integration injects POSTGRES_URL into the api project.
# Keep this file in step with what the code reads (the SUPABASE_* Storage variables
# arrive with the first feature that stores images, ADR 0009).

# Port the HTTP server listens on. Vercel sets PORT itself. Defaults to 8080.
PORT=8080

# App connection (cmd/api, cmd/install): Supabase transaction pooler (port 6543), injected by Vercel
# as POSTGRES_URL. Its role must own the tables or have BYPASSRLS (ADR 0021). Transaction
# mode can't keep prepared statements, so pgx runs in simple-protocol mode (ADR 0006).
POSTGRES_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres

# Migrations (go tool goose, deploy.yml): Supabase session pooler (port 5432, IPv4). Set by
# hand here and as a GitHub Actions secret, not from Vercel. GitHub-hosted runners
# have no IPv6, so the direct connection can't be used.
# Supabase dashboard > Connect > Session pooler.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Optional email access: leave all four empty for legacy-only operation. Set all
# four in the API's Vercel environment to enable /v2 setup/recovery operations.
# No account credentials or API keys belong in this file or in chat.
BREVO_API_KEY=
# An individually verified mailbox in Brevo; the displayed sender name is StockFlow.
EMAIL_SENDER_ADDRESS=
# Trusted web origin, not the API URL. Reset links use /reset-password#token=...
WEB_BASE_URL=
# At least 32 random bytes, shared across every API instance. Used to HMAC OTPs.
# Rotate with a coordinated deployment; previously sent codes must be requested again.
EMAIL_CODE_SECRET=
